# Spring Boot Database Configuration Examples
# Copy relevant sections to your microservice application.properties

# ============================================================================
# CUSTOMER SERVICE - application.properties
# ============================================================================

# Database Connection
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:customer_db}?sslmode=require
spring.datasource.username=${DB_USERNAME:customer_user}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# Connection Pool (HikariCP)
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.connection-test-query=SELECT 1

# JPA / Hibernate
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jpa.properties.hibernate.jdbc.batch_size=20
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true

# Flyway Migration (if using)
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.locations=classpath:db/migration

# Logging
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE
logging.level.com.zaxxer.hikari=INFO

# ============================================================================
# KUBERNETES DEPLOYMENT ENVIRONMENT VARIABLES
# ============================================================================

# These environment variables are injected by Kubernetes from:
# - ConfigMap: customer-db-config
# - Secret: customer-db-credentials (from External Secrets)

# DB_HOST=rds-platform-dev-postgres.xxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=customer_db
# DB_USERNAME=customer_user
# DB_PASSWORD=<from-secrets-manager>
# DB_DRIVER=org.postgresql.Driver
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

